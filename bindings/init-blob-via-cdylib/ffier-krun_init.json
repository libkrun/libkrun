    {
      "name": "Config",
      "destroy_ffi_name": "krun_init_config_destroy",
      "is_builder_type": false,
      "methods": [
        {
          "name": "builder",
          "doc": [
            " Start building a new init configuration."
          ],
          "receiver": "none",
          "params": [],
          "ret": {
            "return_kind": "value",
            "type": "Builder"
          },
          "ffi_name": "krun_init_config_builder"
        },
        {
          "name": "apply",
          "doc": [
            " Apply this init configuration to a VM's filesystem overlay and payload.",
            "",
            " Adds the init binary and associated configuration file(s) as overlay",
            " files, and appends the init kernel command line argument to the payload.",
            " Fails when a control socket is configured: that needs a vsock device,",
            " use [`apply_with_vsock`](Self::apply_with_vsock).",
            "",
            " The caller must keep this `Config` (or `KrunInitConfig`) alive for the",
            " entire lifetime of the VM; `apply` borrows data pointers that remain",
            " referenced until the VM exits.",
            "",
            " Symbols are loaded from the global namespace (`RTLD_DEFAULT`)."
          ],
          "receiver": "ref",
          "method_lifetimes": [
            "a"
          ],
          "params": [
            {
              "name": "overlay",
              "param_kind": "regular",
              "type": "FsOverlay",
              "ref_kind": "mut",
              "type_args": [
                "a"
              ]
            },
            {
              "name": "payload",
              "param_kind": "regular",
              "type": "Payload",
              "ref_kind": "mut"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": null,
            "err_type": "ApplyError",
            "c_convention": "out_param"
          },
          "ffi_name": "krun_init_config_apply",
          "cfg": "feature = \"ffi-client\""
        },
        {
          "name": "apply_with_vsock",
          "doc": [
            " Like [`apply`](Self::apply), and also map the control server's vsock",
            " port to the configured control socket on `vsock`."
          ],
          "receiver": "ref",
          "method_lifetimes": [
            "a"
          ],
          "params": [
            {
              "name": "overlay",
              "param_kind": "regular",
              "type": "FsOverlay",
              "ref_kind": "mut",
              "type_args": [
                "a"
              ]
            },
            {
              "name": "payload",
              "param_kind": "regular",
              "type": "Payload",
              "ref_kind": "mut"
            },
            {
              "name": "vsock",
              "param_kind": "regular",
              "type": "VsockDevice",
              "ref_kind": "mut"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": null,
            "err_type": "ApplyError",
            "c_convention": "out_param"
          },
          "ffi_name": "krun_init_config_apply_with_vsock",
          "cfg": "feature = \"ffi-client\""
        },
        {
          "name": "apply_in",
          "doc": [
            " Like [`apply`](Self::apply), but loads symbols from a specific library",
            " handle (e.g. from `dlopen`). Pass null for `RTLD_DEFAULT`.",
            "",
            " - If `lib_handle` is non-null it must be a valid handle returned by",
            "   `dlopen` (or equivalent) that remains open for the duration of",
            "   this call.",
            " - The caller must keep this `Config` (or `KrunInitConfig`) alive for the",
            "   entire lifetime of the VM."
          ],
          "receiver": "ref",
          "method_lifetimes": [
            "a"
          ],
          "params": [
            {
              "name": "lib_handle",
              "param_kind": "regular",
              "type": "*mut core::ffi::c_void"
            },
            {
              "name": "overlay",
              "param_kind": "regular",
              "type": "FsOverlay",
              "ref_kind": "mut",
              "type_args": [
                "a"
              ]
            },
            {
              "name": "payload",
              "param_kind": "regular",
              "type": "Payload",
              "ref_kind": "mut"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": null,
            "err_type": "ApplyError",
            "c_convention": "out_param"
          },
          "ffi_name": "krun_init_config_apply_in",
          "cfg": "feature = \"ffi-client\""
        },
        {
          "name": "apply_with_vsock_in",
          "doc": [
            " Like [`apply_with_vsock`](Self::apply_with_vsock), loading symbols",
            " from `lib_handle` as [`apply_in`](Self::apply_in) does."
          ],
          "receiver": "ref",
          "method_lifetimes": [
            "a"
          ],
          "params": [
            {
              "name": "lib_handle",
              "param_kind": "regular",
              "type": "*mut core::ffi::c_void"
            },
            {
              "name": "overlay",
              "param_kind": "regular",
              "type": "FsOverlay",
              "ref_kind": "mut",
              "type_args": [
                "a"
              ]
            },
            {
              "name": "payload",
              "param_kind": "regular",
              "type": "Payload",
              "ref_kind": "mut"
            },
            {
              "name": "vsock",

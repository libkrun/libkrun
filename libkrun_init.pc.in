prefix=@prefix@
libdir=@libdir@
includedir=@includedir@

Name: @PACKAGE_NAME@
Version: @PACKAGE_VERSION@
Description: Init binary and configuration builder for libkrun guests
Requires:
Cflags: -I${includedir}
Libs: -L${libdir} -lkrun_init

    {
      "name": "ConsoleBuilder",
      "destroy_ffi_name": "krun_console_builder_destroy",
      "is_builder_type": false,
      "methods": [
        {
          "name": "add_tty_port",
          "doc": [
            " Add a TTY-backed port to the console.",
            "",
            " If the fd refers to a real terminal, raw mode will be enabled on it",
            " when the VM starts, and restored on shutdown.",
            "",
            " # Arguments",
            "",
            " - `name`: the port name visible to the guest (e.g. `\"tty0\"`).",
            " - `tty_fd`: borrowed fd for the host TTY; duplicated internally, caller retains ownership.",
            "",
            " # Returns",
            "",
            " The zero-based port index."
          ],
          "receiver": "mut",
          "params": [
            {
              "name": "name",
              "param_kind": "regular",
              "type": "str",
              "ref_kind": "shared"
            },
            {
              "name": "tty_fd",
              "param_kind": "regular",
              "type": "BorrowedFd",
              "type_args": [
                "a"
              ]
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": {
              "type": "u32"
            },
            "err_type": "Error",
            "c_convention": "out_param"
          },
          "ffi_name": "krun_console_builder_add_tty_port"
        },
        {
          "name": "add_inout_port",
          "doc": [
            " Add a port with separate input and output fds (no terminal properties).",
            " Pass -1 for input_fd or output_fd to disable that direction."
          ],
          "receiver": "mut",
          "params": [
            {
              "name": "name",
              "param_kind": "regular",
              "type": "str",
              "ref_kind": "shared"
            },
            {
              "name": "input_fd",
              "param_kind": "regular",
              "type": "i32"
            },
            {
              "name": "output_fd",
              "param_kind": "regular",
              "type": "i32"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": {
              "type": "u32"
            },
            "err_type": "Error",
            "c_convention": "out_param"
          },
          "ffi_name": "krun_console_builder_add_inout_port"
        },
        {
          "name": "build",
          "doc": [
            " Build the console device. At least one port must have been added."
          ],
          "receiver": "value",
          "params": [],
          "ret": {
            "return_kind": "result",
            "ok": {
              "type": "ConsoleDevice",
              "type_args": [
                "a"
              ]
            },
            "err_type": "Error",
            "c_convention": "handle_or_null"
          },
          "ffi_name": "krun_console_builder_build"
        },
        {
          "name": "add_default_console",
          "doc": [
            " Set up the default console: port 0 (hvc0) plus named redirect ports.",
            "",
            " Replicates the v1 `krun_add_virtio_console_default` behaviour:",
            "",
            " - If any fd is a terminal, port 0 becomes a full TTY console",
            "   (raw mode enabled), and that fd is NOT added as a redirect port.",
            " - Otherwise, port 0 gets log output and named redirect ports",
            "   (`krun-stdin`, `krun-stdout`, `krun-stderr`) are added.",
            "",
            " Pass -1 to skip a stream."
          ],
          "receiver": "mut",
          "params": [
            {
              "name": "stdin",
              "param_kind": "regular",
              "type": "RawFd"
            },
            {
              "name": "stdout",
              "param_kind": "regular",
              "type": "RawFd"
            },
            {
              "name": "stderr",
              "param_kind": "regular",
              "type": "RawFd"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": null,
            "err_type": "Error",
            "c_convention": "out_param"
          },
          "ffi_name": "krun_console_builder_add_default_console"
        }
      ]
    },

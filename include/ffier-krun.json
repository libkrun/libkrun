        },
        {
          "name": "add",
          "doc": [
            " Add a device to this manager.",
            "",
            " Devices are attached in the order they are added. The device must",
            " implement [`AttachDevice`] — all built-in device types",
            " (`FsDevice`, `ConsoleDevice`, etc.) implement this trait."
          ],
          "receiver": "mut",
          "params": [
            {
              "name": "device",
              "param_kind": "impl_trait",
              "trait_name": "AttachDevice",
              "type_args": [
                "a"
              ]
            }
          ],
          "ret": {
            "return_kind": "value",
            "type": "Self"
          },
          "ffi_name": "krun_mmio_device_manager_add"
        }
      ]
    },
    {
      "name": "FsDevice",
      "destroy_ffi_name": "krun_fs_device_destroy",
      "is_builder_type": false,
      "methods": [
        {
          "name": "new",
          "doc": [
            " Create a new virtiofs device sharing a host directory.",
            "",
            " # Arguments",
            "",
            " - `tag`: the filesystem tag visible to the guest (e.g. `\"/dev/root\"`).",
            " - `host_path`: the host directory to share."
          ],
          "receiver": "none",
          "params": [
            {
              "name": "tag",
              "param_kind": "regular",
              "type": "str",
              "ref_kind": "shared"
            },
            {
              "name": "host_path",
              "param_kind": "regular",
              "type": "str",
              "ref_kind": "shared"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": {
              "type": "FsDevice",
              "type_args": [
                "a"
              ]
            },
            "err_type": "Error",
            "c_convention": "handle_or_null"
          },
          "ffi_name": "krun_fs_device_new"
        },
        {
          "name": "new_read_only",
          "doc": [
            " Create a read-only virtiofs device sharing a host directory."
          ],
          "receiver": "none",
          "params": [
            {
              "name": "tag",
              "param_kind": "regular",
              "type": "str",
              "ref_kind": "shared"
            },
            {
              "name": "host_path",
              "param_kind": "regular",
              "type": "str",
              "ref_kind": "shared"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": {
              "type": "FsDevice",
              "type_args": [
                "a"
              ]
            },
            "err_type": "Error",
            "c_convention": "handle_or_null"
          },
          "ffi_name": "krun_fs_device_new_read_only"
        },
        {
          "name": "new_null",
          "doc": [
            " Create a virtiofs device with no host directory (NullFs).",
            "",
            " The guest sees an empty filesystem. Use",
            " [`add_overlay_dir`](Self::add_overlay_dir) and",
            " [`add_overlay_file`](Self::add_overlay_file) to populate it",
            " with virtual entries."
          ],
          "receiver": "none",
          "params": [
            {
              "name": "tag",
              "param_kind": "regular",
              "type": "str",
              "ref_kind": "shared"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": {
              "type": "FsDevice",
              "type_args": [
                "a"
              ]
            },
            "err_type": "Error",
            "c_convention": "handle_or_null"
          },
          "ffi_name": "krun_fs_device_new_null"
        },
        {
          "name": "add_overlay_dir",
          "doc": [
            " Add a virtual directory overlay entry.",
            "",
            " `path` may contain `/` separators for nested entries (e.g.",
            " `\"etc/nested\"`). Intermediate directories must already exist."
          ],
          "receiver": "mut",
          "params": [
            {
              "name": "path",
              "param_kind": "regular",
              "type": "str",
              "ref_kind": "shared"
            },
            {
              "name": "mode",
              "param_kind": "regular",
              "type": "u32"
            }
          ],
          "ret": {
            "return_kind": "void"
          },
          "ffi_name": "krun_fs_device_add_overlay_dir"
        },
        {
          "name": "add_overlay_file",
          "doc": [
            " Add a virtual file overlay entry.",
            "",
            " `path` may contain `/` separators for nested entries (e.g.",
            " `\"etc/nested/deep.txt\"`). Intermediate directories must already",
            " exist."
          ],
          "receiver": "mut",
          "params": [
            {
              "name": "path",
              "param_kind": "regular",
              "type": "str",
              "ref_kind": "shared"
            },
            {
              "name": "data",
              "param_kind": "regular",
              "type": "[u8]",
              "ref_kind": "shared"
            },
            {
              "name": "mode",
              "param_kind": "regular",
              "type": "u32"
            },
            {
              "name": "one_shot",
              "param_kind": "regular",
              "type": "bool"
            }
          ],
          "ret": {
            "return_kind": "void"
          },
          "ffi_name": "krun_fs_device_add_overlay_file"
        },
        {
          "name": "set_overlay",
          "doc": [
            " Apply a pre-built [`FsOverlay`] to this device.",
            "",
            " All entries from the overlay are added as virtual entries into",
            " the underlying virtiofs device."
          ],
          "receiver": "mut",
          "params": [
            {
              "name": "overlay",
              "param_kind": "regular",
              "type": "FsOverlay"
            }
          ],
          "ret": {
            "return_kind": "void"
          },
          "ffi_name": "krun_fs_device_set_overlay"
        },
        {
          "name": "set_dax_window_size",
          "doc": [
            " Set the size of the DAX (direct access) shared memory window.",
            "",
            " When set, the guest can memory-map files from the shared filesystem",
            " directly into its address space, avoiding data copies. If not set,",
            " no DAX window is allocated."
          ],
          "receiver": "mut",
          "params": [
            {
              "name": "bytes",
              "param_kind": "regular",
              "type": "u64"
            }
          ],
          "ret": {
            "return_kind": "void"
          },
          "ffi_name": "krun_fs_device_set_dax_window_size"
        }
      ]
    },

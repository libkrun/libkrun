    {
      "name": "Config",
      "destroy_ffi_name": "krun_init_config_destroy",
      "is_builder_type": false,
      "methods": [
        {
          "name": "builder",
          "doc": [
            " Start building a new init configuration."
          ],
          "receiver": "none",
          "params": [],
          "ret": {
            "return_kind": "value",
            "type": "Builder"
          },
          "ffi_name": "krun_init_config_builder"
        },
        {
          "name": "apply",
          "doc": [
            " Apply this init configuration to a VM's filesystem overlay and payload.",
            "",
            " Adds the init binary and associated configuration file(s) as overlay",
            " files, and appends the init kernel command line argument to the payload.",
            "",
            " Symbols are loaded from the global namespace (`RTLD_DEFAULT`)."
          ],
          "receiver": "ref",
          "params": [
            {
              "name": "overlay",
              "param_kind": "regular",
              "type": "FsOverlay",
              "ref_kind": "mut"
            },
            {
              "name": "payload",
              "param_kind": "regular",
              "type": "Payload",
              "ref_kind": "mut"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": null,
            "err_type": "ApplyError",
            "c_convention": "out_param"
          },
          "ffi_name": "krun_init_config_apply",
          "cfg": "feature = \"ffi-client\""
        },
        {
          "name": "apply_in",
          "doc": [
            " Like [`apply`](Self::apply), but loads symbols from a specific library",
            " handle (e.g. from `dlopen`). Pass null for `RTLD_DEFAULT`."
          ],
          "receiver": "ref",
          "params": [
            {
              "name": "lib_handle",
              "param_kind": "regular",
              "type": "*mut core::ffi::c_void"
            },
            {
              "name": "overlay",
              "param_kind": "regular",
              "type": "FsOverlay",
              "ref_kind": "mut"
            },
            {
              "name": "payload",
              "param_kind": "regular",
              "type": "Payload",
              "ref_kind": "mut"
            }
          ],
          "ret": {
            "return_kind": "result",
            "ok": null,
            "err_type": "ApplyError",
            "c_convention": "out_param"
          },
          "ffi_name": "krun_init_config_apply_in",
          "cfg": "feature = \"ffi-client\""
        }
      ]
    },
